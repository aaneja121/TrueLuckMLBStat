# Contact Luck Prototype v0.1 -- environment variable template.
#
# No secrets or API keys are required for the current prototype:
# pybaseball's `statcast()` scrapes public Baseball Savant CSV endpoints and
# needs no credentials. This file exists as a placeholder for future
# extensions (e.g. weather API keys, external data providers).
#
# Copy this file to `.env` and fill in values if/when needed:
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed.

# Optional: override the default project data directory (defaults to ./data).
# MLB_LUCK_DATA_DIR=./data

# Optional: override the default artifacts directory (defaults to ./artifacts).
# MLB_LUCK_ARTIFACTS_DIR=./artifacts

# Placeholder for a future weather-data provider API key (not used in v0.1).
# WEATHER_API_KEY=
